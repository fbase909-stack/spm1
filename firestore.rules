rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // An admin is any signed-in user with a document at /admins/{their uid}.
    // Create that document by hand in the Firebase console (see README).
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Catalog: anyone can read (the live store), only admins can change it.
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Users can check whether they themselves are an admin. Nobody can grant admin from the website.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
