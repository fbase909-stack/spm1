rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Same admin check as firestore.rules, read across from Firestore.
    function isAdmin() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    // Product photos: public to view, only admins can upload or delete.
    // Uploads must be JPG, PNG or WebP and under 5 MB (the admin panel compresses before upload).
    match /products/{productId}/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
